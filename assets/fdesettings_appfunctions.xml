<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
  Settings App Functions 静态描述（框架 legacy XML asset 格式，由系统 AppSearch 索引读取）。

  通过 App Functions 暴露能力，供系统智能体（Agent）/ App Function 调用方使用：
    - openSettingsPage  打开指定设置页面（参数 page: wifi/display/sound/apps/storage）
    - adjustBrightness  调节屏幕亮度（参数 action: dim/brighten，可选 step: 每次调节的
      亮度百分比，默认 10；亮度换算逻辑参考 BrightnessLevelPreference.kt）
    - adjustMediaVolume 调节媒体音量（参数 action: volume_up/volume_down/mute/unmute，可选
      step: 每次调节的音量百分比，默认 10，仅对 volume_up/volume_down 生效；结果含 muted 字段）
    - setDarkTheme      开启/关闭深色主题（参数 action: on/off）
    - openApp           按包名或应用名打开某个应用（参数 packageName 或 appName，至少提供一个）

  openSettingsPage 的功能与 FdeSystemControl 的 SystemControlService.openSettingsPage 保持一致。
  该 XML 由 OpenSettingsPageAppFunctionService 通过
  <property android:name="android.app.appfunctions" android:value="..."/> 引用。
-->
<appfunctions>
    <appfunction>
        <function_id>openSettingsPage</function_id>
        <schema_name>openSettingsPage</schema_name>
        <schema_version>1</schema_version>
        <schema_category>settings</schema_category>
        <enabled_by_default>true</enabled_by_default>
    </appfunction>
    <appfunction>
        <function_id>adjustBrightness</function_id>
        <schema_name>adjustBrightness</schema_name>
        <schema_version>1</schema_version>
        <schema_category>settings</schema_category>
        <enabled_by_default>true</enabled_by_default>
    </appfunction>
    <appfunction>
        <function_id>adjustMediaVolume</function_id>
        <schema_name>adjustMediaVolume</schema_name>
        <schema_version>1</schema_version>
        <schema_category>settings</schema_category>
        <enabled_by_default>true</enabled_by_default>
    </appfunction>
    <appfunction>
        <function_id>setDarkTheme</function_id>
        <schema_name>setDarkTheme</schema_name>
        <schema_version>1</schema_version>
        <schema_category>settings</schema_category>
        <enabled_by_default>true</enabled_by_default>
    </appfunction>
    <appfunction>
        <function_id>openApp</function_id>
        <schema_name>openApp</schema_name>
        <schema_version>1</schema_version>
        <schema_category>apps</schema_category>
        <enabled_by_default>true</enabled_by_default>
    </appfunction>
</appfunctions>

<?xml version="1.0" encoding="utf-8"?>

 <ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <LinearLayout 
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center|top"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginHorizontal="115dp"
            android:layout_marginTop="19dp"
            android:background="#0a000000"
            android:orientation="horizontal">




            <TextView
                android:id="@+id/txtWired"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:background="@drawable/textview_background_selector"
                android:gravity="center"
                android:text="@string/fde_net_connect_wired" />


            <TextView
                android:id="@+id/txtWifi"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:background="@drawable/textview_background_selector"
                android:gravity="center"
                android:text="@string/fde_net_connect_wifi" />


        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutWifi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="18dp"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#14000000"
                app:cardCornerRadius="8dp"
                app:cardElevation="6dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="49dp"
                    android:background="#fff"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center|left"
                        android:textColor="#d9000000"
                        android:textSize="14sp"
                        android:fontFamily="@font/alibaba_puhui_65_medium_65_medium"
                        android:text="@string/open_wifi"  />


                    <CheckBox
                        android:id="@+id/switchComp"
                        android:layout_width="42dp"
                        android:layout_height="22dp"
                        android:background="@drawable/switch_selector"
                        android:button="@null"
                        android:gravity="center|right" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <LinearLayout
                android:id="@+id/layoutSavedTitle"
                android:layout_marginTop="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:orientation="horizontal"
                >
                <TextView
                    android:id="@+id/txtSavedTitle"
                    android:layout_width="wrap_content"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/fde_net_saved_network"
                    android:textAppearance="@style/item_title" />

                <ImageView
                    android:id="@+id/imgSavedLoading"
                    android:layout_width="24dp"
                    android:visibility="invisible"
                    android:layout_gravity="center"
                    android:layout_height="24dp"/>

            </LinearLayout>    

            <androidx.cardview.widget.CardView
                android:id="@+id/cardSaved"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="18dp"
                app:cardBackgroundColor="#14000000"
                app:cardCornerRadius="8dp"
                app:cardElevation="6dp"
                app:cardUseCompatPadding="true">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#fff"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtSavedNoData"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="14dp"
                        android:text="@string/fde_net_none"
                        android:textColor="#4d000000"
                        android:textSize="14sp"
                        android:fontFamily="@font/alibaba_puhui_55_regular_55_regular"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerViewSaved"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#0d000000"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintHeight_max="147dp"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>


            <LinearLayout
                android:id="@+id/layoutOtherTitle"
                android:layout_marginTop="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:orientation="horizontal"
                >
                <TextView
                    android:id="@+id/txtOtherTitle"
                    android:layout_width="wrap_content"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/fde_net_other_networks"
                    android:textAppearance="@style/item_title" />

                <ImageView
                    android:id="@+id/imgOtherLoading"
                    android:layout_width="24dp"
                    android:visibility="invisible"
                    android:layout_gravity="center"
                    android:layout_height="24dp"/>

            </LinearLayout>    

            <androidx.cardview.widget.CardView
                android:id="@+id/cardOther"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="18dp"
                app:cardBackgroundColor="#14000000"
                app:cardCornerRadius="8dp"
                app:cardElevation="6dp"
                app:cardUseCompatPadding="true">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#fff"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtOtherNoData"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="14dp"
                        android:text="@string/fde_net_none"
                        android:textColor="#4d000000"
                        android:textSize="14sp"
                        android:fontFamily="@font/alibaba_puhui_55_regular_55_regular"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/txtAddWifi"/>


                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerViewOther"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#0d000000"
                        android:visibility="gone"
                        android:paddingTop="34dp"
                        android:layout_marginBottom="18dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/txtAddWifi"/>

                    <TextView
                        android:id="@+id/txtAddWifi"
                        android:text="@string/fde_net_add_networks"
                        android:padding="14dp"
                        android:textColor="#d9000000"
                        android:textSize="14sp"
                        android:fontFamily="@font/alibaba_puhui_55_regular_85_bold"
                        android:background="#FFF"
                        android:layout_width="match_parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:layout_height="wrap_content"/>


                </androidx.constraintlayout.widget.ConstraintLayout>



            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutWired"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="18dp"
                android:layout_marginTop="27dp"
                app:cardBackgroundColor="#14000000"
                app:cardCornerRadius="8dp"
                app:cardElevation="6dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="49dp"
                    android:background="#fff"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center|left"
                        android:text="@string/fde_net_networks"
                        android:textColor="#d9000000"
                        android:fontFamily="@font/alibaba_puhui_55_regular_55_regular"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtWiredStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center|right"
                        android:fontFamily="@font/alibaba_puhui_55_regular_55_regular"
                        android:text="@string/fde_has_connected"
                        android:textColor="#ff318BF3"
                        android:textSize="14sp" />


                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                android:text="@string/fde_net_config"
                android:textAppearance="@style/item_title" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="18dp"
                app:cardBackgroundColor="#14000000"
                app:cardCornerRadius="8dp"
                app:cardElevation="6dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#ffF0F2F5"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="1dp"
                        android:background="#fff"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:gravity="left|center"
                            android:text="@string/configurable_interfaces"
                            android:textAppearance="@style/item_child_title" />


                        <androidx.appcompat.widget.AppCompatSpinner
                            android:id="@+id/spinnerConfigInterface"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:background="@drawable/custom_spinner_background"
                            android:dropDownVerticalOffset="48dp"
                            android:gravity="center|right"
                            android:paddingRight="16dp"
                            android:spinnerMode="dropdown"
                            android:textAppearance="@style/item_child_value"
                            android:visibility="visible" />
                    </RelativeLayout>


                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="1dp"
                        android:background="#fff"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:gravity="left|center"
                            android:text="@string/ip_settings"
                            android:textAppearance="@style/item_child_title" />


                        <androidx.appcompat.widget.AppCompatSpinner
                            android:id="@+id/spinnerIpSettings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:background="@drawable/custom_spinner_background"
                            android:dropDownVerticalOffset="48dp"
                            android:entries="@array/spinner_ip"
                            android:gravity="center|right"
                            android:paddingRight="14dp"
                            android:spinnerMode="dropdown"
                            android:textAppearance="@style/item_child_value"
                            android:visibility="visible" />
                    </RelativeLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="1dp"
                        android:background="#fff"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="left|center"
                            android:text="@string/ip_address"
                            android:textAppearance="@style/item_child_title" />

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/editIpAddress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="#fff"
                            android:gravity="right|center"
                            android:hint="input"
                            android:textAppearance="@style/item_child_value" />
                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="1dp"
                        android:background="#fff"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="left|center"
                            android:text="@string/default_gateway"
                            android:textAppearance="@style/item_child_title" />

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/editDefaultGateway"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="#fff"
                            android:gravity="right|center"
                            android:hint="input"
                            android:textAppearance="@style/item_child_value" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="1dp"
                        android:background="#fff"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="left|center"
                            android:text="@string/subnet_mask"
                            android:textAppearance="@style/item_child_title" />

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/editSubnetMask"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="#fff"
                            android:gravity="right|center"
                            android:hint="input"
                            android:textAppearance="@style/item_child_value" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="1dp"
                        android:background="#fff"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="left|center"
                            android:text="@string/preferred_dns"
                            android:textAppearance="@style/item_child_title" />

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/editPreferredDns"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="#fff"
                            android:gravity="right|center"
                            android:textAppearance="@style/item_child_value"
                            android:hint="input" />
                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="1dp"
                        android:background="#fff"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="left|center"
                            android:text="@string/alternative_dns"
                            android:textAppearance="@style/item_child_title" />

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/editAlternativeDns"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="#fff"
                            android:gravity="right|center"
                            android:hint="input"
                            android:textAppearance="@style/item_child_value" />
                    </LinearLayout>


                </LinearLayout>


            </androidx.cardview.widget.CardView>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal">


                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCancel"
                    android:layout_width="84dp"
                    android:layout_height="32dp"
                    android:layout_marginRight="16dp"
                    android:layout_toLeftOf="@id/btnSave"
                    android:background="@drawable/btn_grep_background_selector"
                    android:gravity="center"
                    android:visibility="gone"
                    android:text="@string/fde_btn_cancel"
                    android:textColor="#d9000000"
                    android:fontFamily="@font/alibaba_puhui_65_medium_65_medium"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSave"
                    android:layout_width="84dp"
                    android:layout_height="32dp"
                    android:layout_alignParentRight="true"
                    android:layout_gravity="right"
                    android:background="@drawable/btn_blue_background_selector"
                    android:text="@string/fde_btn_confirm"
                    android:textColor="#e6FFFFFF"
                    android:fontFamily="@font/alibaba_puhui_65_medium_65_medium"
                    android:textSize="14sp" />


            </RelativeLayout>


        </LinearLayout>


    </LinearLayout>
</ScrollView>